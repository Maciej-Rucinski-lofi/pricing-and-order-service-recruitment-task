# Copy to .env and fill in values (never commit .env)

# Graftcode Portal — https://portal.graftcode.com
# Create workspace → Create New Service → copy Project Key
PROJECT_KEY=your_project_key_here

# Order Service pricing backend: LOCAL (in-process) or REMOTE (Graft)
PRICING_MODE=LOCAL

# REMOTE mode only — copy from Graftcode Vision after Pricing Gateway is running
# Monolith example: name=graft-pypi-pricingservice;host=inMemory;runtime=python;modules=./pricing_service
# Microservice example: name=graft-pypi-pricingservice;host=localhost:9092;runtime=python;modules=./pricing_service
GRAFT_CONFIG=

# Optional: Python module name for installed Pricing Graft (if import fails)
# GRAFT_PACKAGE_MODULE=graft_pypi_pricing_and_order_services_bbicbb

# Gateway ports (use non-80/81 on Windows if those ports are taken)
PRICING_GATEWAY_WS_PORT=9080
PRICING_GATEWAY_HTTP_PORT=9081
ORDER_GATEWAY_WS_PORT=9082
ORDER_GATEWAY_HTTP_PORT=9083
