# Order Gateway: app installed at build time; source bind-mounted at run for fast restarts.
FROM python:3.12-bookworm

ARG GG_VERSION=1.2.7

WORKDIR /app

RUN apt-get update \
    && apt-get install -y wget ca-certificates \
    && wget -q -O /tmp/gg.deb "https://github.com/grft-dev/graftcode-gateway/releases/download/v${GG_VERSION}/gg_linux_amd64.deb" \
    && dpkg -i /tmp/gg.deb \
    && rm /tmp/gg.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY config/ ./config/
COPY pricing_service/ ./pricing_service/
COPY order_service/ ./order_service/

RUN pip install --no-cache-dir -e .

COPY scripts/docker-entrypoint-order-gateway.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

ENV PYTHONPATH=/app

EXPOSE 9082 9083

ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
